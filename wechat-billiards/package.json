{
  "name": "friend-billiards",
  "version": "0.3.3",
  "private": true,
  "description": "A GPL-3.0 WeChat mini game with eight-ball, nine-ball, snooker and authoritative friend rooms.",
  "license": "GPL-3.0-only",
  "packageManager": "yarn@4.9.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "webpack serve --config apps/web-preview/webpack.config.cjs",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "build": "node scripts/build.mjs",
    "build:web": "webpack --config apps/web-preview/webpack.config.cjs --mode production",
    "build:minigame": "webpack --config apps/minigame/webpack.config.cjs --mode production",
    "build:server": "esbuild apps/server/src/index.ts --bundle --platform=node --target=node24 --format=cjs --external:@cloudbase/node-sdk --outfile=apps/server/dist/index.cjs",
    "lint": "tsc --noEmit && eslint .",
    "test": "jest --config test/jest.config.cjs --runInBand",
    "test:protocol": "jest --config test/jest.config.cjs --runInBand --testPathPatterns=protocol",
    "test:e2e": "yarn build:server && node scripts/e2e.mjs",
    "physics:benchmark": "tsx scripts/physics-benchmark.mjs",
    "format": "prettier --write \"apps/**/*.{ts,js,json,css,html}\" \"packages/**/*.{ts,js,json}\" \"test/**/*.{ts,js,cjs}\" \"scripts/**/*.mjs\" \"*.{json,mjs,cjs}\"",
    "source:archive": "node scripts/source-archive.mjs"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "^3.0.0",
    "@tailuge/messaging": "1.48.0",
    "fflate": "^0.8.3",
    "interactjs": "1.10.28",
    "jsoncrush": "^1.1.8",
    "three": "0.187.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "@types/ws": "^8.18.1",
    "copy-webpack-plugin": "^13.0.1",
    "esbuild": "^0.27.0",
    "eslint": "10.15.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "prettier": "3.10.1",
    "swc-loader": "0.2.7",
    "terser-webpack-plugin": "^5.6.1",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1",
    "webpack-dev-server": "6.1.0"
  }
}
