{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node", "jest"],
    "paths": {
      "@friend-billiards/core": ["./packages/core/src/index.ts"],
      "@friend-billiards/protocol": ["./packages/protocol/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "test/**/*.ts",
    "third_party/billiards/src/**/*.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
